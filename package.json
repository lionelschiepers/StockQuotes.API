{
  "name": "stockquote-api",
  "version": "1.0.0",
  "main": "dist/src/functions/*.js",
  "description": "",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:production": "pnpm run prestart:production && pnpm prune --prod",
    "watch": "tsc -p tsconfig.build.json --w",
    "prestart": "pnpm run build && func extensions install",
    "prestart:production": "pnpm run build",
    "start:host": "func start --cors *",
    "start": "concurrently --kill-others --names host,tsc --prefix-colors blue,green \"pnpm run start:host\" \"pnpm run watch\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "{src,tests}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md,js}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@azure/functions": "^4.17.0",
    "axios": "^1.21.0",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "azure-functions-core-tools": "^4.16.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
